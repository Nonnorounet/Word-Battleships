{
  "name": "word-battleships",
  "version": "0.1.0",
  "private": true,
  "description": "Word Battleships: a two-team English sentence game with a 3D board.",
  "author": "Nonnorounet",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "build:exe": "npm run build:web && electron-builder --win portable",
    "build:apk": "npm run build:web && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "com.nonnorounet.wordbattleships",
    "productName": "Word Battleships",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "WordBattleships-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/three": "^0.159.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "peerjs": "^1.5.5",
    "three": "^0.159.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
